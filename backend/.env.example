OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini

# Question generation is disabled unless explicitly enabled.
CYBERQUIZ_ENABLE_GENERATION=false

# Required when generation is enabled. Use a long random server-side secret.
CYBERQUIZ_ADMIN_KEY=replace_with_a_long_random_secret

# In-app contact form. Keep SMTP credentials only on the backend host.
CYBERQUIZ_CONTACT_ENABLED=false
CYBERQUIZ_SMTP_HOST=smtp.example.com
CYBERQUIZ_SMTP_PORT=587
CYBERQUIZ_SMTP_USERNAME=replace_me
CYBERQUIZ_SMTP_PASSWORD=replace_me
CYBERQUIZ_SMTP_SECURITY=starttls
CYBERQUIZ_CONTACT_FROM=cyberquiz@example.com
CYBERQUIZ_CONTACT_TO=elikto@proton.me
