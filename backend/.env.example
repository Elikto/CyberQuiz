OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini

# Question generation is disabled unless explicitly enabled.
CYBERQUIZ_ENABLE_GENERATION=false

# Required when generation is enabled. Use a long random server-side secret.
CYBERQUIZ_ADMIN_KEY=replace_with_a_long_random_secret

# In-app contact form. Keep the Resend key only on the backend host.
CYBERQUIZ_CONTACT_ENABLED=false
RESEND_API_KEY=replace_me
CYBERQUIZ_CONTACT_INBOX_SEGMENT_ID=replace_with_resend_segment_id

# Optional notification email. Contact submissions are persisted even if delivery fails.
CYBERQUIZ_CONTACT_FROM=CyberQuiz <contact@example.com>
CYBERQUIZ_CONTACT_TO=elikto@proton.me

# Optional urgent Telegram alert. Keep the bot token and chat ID server-side.
CYBERQUIZ_URGENT_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=replace_me
CYBERQUIZ_URGENT_TELEGRAM_CHAT_ID=replace_me

# Accounts, friends and synchronized quizzes. All values stay server-side.
DATABASE_URL=postgresql://user:password@host/database
CYBERQUIZ_AUTH_JWT_SECRET=replace_with_at_least_32_random_characters

# Public OAuth Web client ID used to validate Google ID tokens. No client secret is stored in the APK.
CYBERQUIZ_GOOGLE_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com
